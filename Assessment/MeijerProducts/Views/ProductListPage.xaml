<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MeijerProducts.ViewModels"
             xmlns:models="clr-namespace:MeijerProducts.Models"
             x:Class="MeijerProducts.Views.ProductListPage"
             x:DataType="vm:ProductListViewModel"
             Title="Products">

    <Grid RowDefinitions="Auto,*">
        <Image Grid.Row="0"
               Source="meijerlogo_primary_fullcolor.png"
               Aspect="AspectFit"
               HeightRequest="40"
               Margin="0,12"
               HorizontalOptions="Center"
               SemanticProperties.Description="Meijer logo" />

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadProductsCommand}">
            <CollectionView ItemsSource="{Binding Products}"
                             SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="{Binding ErrorMessage, FallbackValue='No products found.'}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProductSummary">
                        <Grid Padding="12" ColumnDefinitions="80,*" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductListViewModel}}, Path=GoToDetailsCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Image Grid.Column="0"
                                   Source="{Binding ImageUrl}"
                                   Aspect="AspectFit"
                                   HeightRequest="80"
                                   WidthRequest="80" />

                            <VerticalStackLayout Grid.Column="1"
                                                  VerticalOptions="Center"
                                                  Spacing="4">
                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Text="{Binding Summary}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
