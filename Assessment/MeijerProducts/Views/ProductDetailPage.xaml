<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MeijerProducts.ViewModels"
             x:Class="MeijerProducts.Views.ProductDetailPage"
             x:DataType="vm:ProductDetailViewModel"
             Title="Product Details">

    <Grid>
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center" />

        <Label Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Padding="24"
               HorizontalTextAlignment="Center" />

        <ScrollView IsVisible="{Binding Product, Converter={StaticResource NullToBoolConverter}}">
            <VerticalStackLayout Padding="20" Spacing="16">
                <Image Source="{Binding Product.ImageUrl}"
                       Aspect="AspectFit"
                       HeightRequest="260" />

                <Label Text="{Binding Product.Title}"
                       FontAttributes="Bold"
                       FontSize="24" />

                <Label Text="{Binding Product.Price}"
                       FontSize="20"
                       TextColor="{StaticResource Primary}" />

                <Label Text="{Binding Product.Description}"
                       FontSize="16" />

                <Button Text="Add to list"
                        Command="{Binding AddToListCommand}"
                        Margin="0,8,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
